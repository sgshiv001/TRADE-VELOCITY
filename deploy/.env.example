# This is NOT a live configuration. Use your domain and a generated random key.
TRADEVELOCITY_DOMAIN=your-domain.example
TRADEVELOCITY_MODE=private
TRADEVELOCITY_ACCESS_KEY=REPLACE_WITH_A_RANDOM_KEY_OF_AT_LEAST_32_CHARACTERS
# Optional PostgreSQL connection. An empty value uses the persistent SQLite volume.
# Supply the real connection string through protected environment configuration.
TRADEVELOCITY_DATABASE_URL=
