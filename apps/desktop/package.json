{
  "name": "@tradevelocity/desktop",
  "version": "2.0.1",
  "private": true,
  "description": "TradeVelocity desktop paper trading client",
  "author": "TradeVelocity",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && electron .",
    "package": "pnpm build && electron-builder",
    "package:windows:admin": "electron-builder --config electron-admin.yml --win portable --x64",
    "package:windows:trader": "electron-builder --config electron-trader.yml --win portable --x64"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "typescript": "~5.9.3"
  }
}
