{
  "expo": {
    "name": "TradeVelocity",
    "slug": "tradevelocity",
    "scheme": "tradevelocity",
    "version": "2.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {"package": "com.tradevelocity.nativeapp", "versionCode": 2, "adaptiveIcon": {"foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#090c10"}},
    "ios": {"bundleIdentifier": "com.tradevelocity.nativeapp", "buildNumber": "2", "supportsTablet": true},
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-local-authentication", {"faceIDPermission": "Unlock your TradeVelocity session."}],
      "./plugins/with-windows-cmake.cjs"
    ]
  }
}
